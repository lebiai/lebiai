{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "lebi-AI",
  "mainBinaryName": "lebi-AI",
  "version": "1.0.0",
  "identifier": "com.lebi.ai",
  "build": {
    "frontendDist": "./ui/dist",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "lebi-AI",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
