{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "lebi-AI",
  "mainBinaryName": "lebi-AI",
  "version": "1.3.0",
  "identifier": "com.lebi.ai",
  "build": {
    "frontendDist": "./ui/dist",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "lebi-AI",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMEQ2NDM4MDFEQ0VDQkYKUldTLzdOd0JPR1FOWUpHcjNnYlQ5Nko4L0ZqN1FPZDRtNUU0a2RBOFU5WjRyOE9OMXBuQ21WdEQK",
      "endpoints": [
        "https://github.com/lebiai/lebiai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
